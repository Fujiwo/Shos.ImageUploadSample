@model ImageListViewModel
@{
    ViewData["Title"] = "Upload Image";
}

<h2>@ViewData["Title"]</h2>

<div>
    <hr>
    <div class="row">
        @foreach (var image in Model.Images) {
            <div class="col-auto">
                @* Without JavaScript, the link opens the original image directly. *@
                <a href="@Url.Action("Original", new { id = image.Id })" target="_blank"
                   data-bs-toggle="modal" data-bs-target="#originalModal"
                   data-caption="@image.AlternativeText" data-width="@image.Width" data-height="@image.Height">
                    <img src="@Url.Action("Thumbnail", new { id = image.Id })" width="@(image.ThumbnailWidth)" height="@(image.ThumbnailHeight)" alt="@image.AlternativeText" class="img-thumbnail" />
                </a>
            </div>
        }
    </div>
    @if (Model.TotalPages > 1) {
        <nav aria-label="Image pages">
            <ul class="pagination">
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++) {
                    <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="Upload" asp-route-page="@pageNumber">@pageNumber</a>
                    </li>
                }
            </ul>
        </nav>
    }
    <hr>
</div>

@* Shared by all thumbnails. The original image is loaded only when the modal is opened. *@
<div class="modal fade" id="originalModal" tabindex="-1" aria-labelledby="originalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="originalModalLabel"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="originalImage" class="img-fluid" alt="">
            </div>
        </div>
    </div>
</div>

<form method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label for="file" class="form-label">Choose Image</label>
        <input type="file" id="file" name="file" accept="image/png,image/jpeg,image/gif,image/bmp,image/webp" class="form-control">
        <label for="fileDescription" class="form-label">Description</label>
        <input type="text" id="fileDescription" name="description" maxlength="@ImageRecord.DescriptionMaxLength" placeholder="Description (optional)" class="form-control">
    </div>
    <button type="submit" class="btn btn-primary">Upload</button>
</form>

<form>
    <div class="form-group">
        <div class="form-control">
            <button type="button" id="camera" class="btn btn-primary">Camera</button>
            <button type="button" id="snap" class="btn btn-secondary" hidden="hidden">Snap</button>
            <button type="button" id="uploadPicture" class="btn btn-success" hidden="hidden">Upload</button>
        </div>
        <div id="videoPreview" class="form-control" hidden="hidden">
            <video id="video" width="600" height="400" autoplay="autoplay"></video>
        </div>
        <div id="canvasPreview" class="form-control" hidden="hidden">
            <canvas id="canvas" width="600" height="400"></canvas>
        </div>
        <div id="descriptionGroup" hidden="hidden">
            <label for="description" class="form-label">Description</label>
            <input type="text" id="description" maxlength="@ImageRecord.DescriptionMaxLength" placeholder="Description (optional)" class="form-control">
        </div>
    </div>
</form>

@section Scripts {
    <script>
    window.addEventListener('DOMContentLoaded', main)

    let currentStream = null

    function main() {
        document.querySelector('#camera').addEventListener('click', startCamera)
        document.querySelector('#snap').addEventListener('click', snap)
        document.querySelector('#uploadPicture').addEventListener('click', upload)

        const originalModal = document.querySelector('#originalModal')
        originalModal.addEventListener('show.bs.modal', showOriginal)
        originalModal.addEventListener('hidden.bs.modal', clearOriginal)
    }

    function showOriginal(e) {
        const link          = e.relatedTarget
        const originalImage = document.querySelector('#originalImage')

        // Sets the size first to keep the aspect ratio while loading.
        originalImage.width  = link.dataset.width
        originalImage.height = link.dataset.height
        originalImage.alt    = link.dataset.caption
        originalImage.src    = link.href
        // textContent, not innerHTML: the description is user input.
        document.querySelector('#originalModalLabel').textContent = link.dataset.caption
    }

    // Prevents the previous image from flashing when the modal is opened next time.
    function clearOriginal() {
        document.querySelector('#originalImage').removeAttribute('src')
    }

    function stopCamera() {
        if (currentStream) {
            currentStream.getTracks().forEach(track => track.stop())
            currentStream = null
        }
    }

    function startCamera(e) {
        if (e.cancelable)
            e.preventDefault()

        stopCamera()

        const video      = document.querySelector('#video')
        const resolution = { width: 1080, height: 720 }

        navigator.mediaDevices.getUserMedia({
            audio: false,
            video: {
                width : { ideal: resolution.width  },
                height: { ideal: resolution.height }
            }
        }).then(function (stream) {
            currentStream   = stream
            video.srcObject = stream
        }).catch(function (error) {
            console.error('mediaDevice.getUserMedia() error:', error)
            alert('Could not start the camera.')
        })

        document.querySelector('#canvasPreview'   ).hidden = true
        document.querySelector('#uploadPicture'   ).hidden = true
        document.querySelector('#descriptionGroup').hidden = true
        document.querySelector('#videoPreview'    ).hidden = false
        document.querySelector('#snap'            ).hidden = false
    }

    function snap(e) {
        if (e.cancelable)
            e.preventDefault()

        const canvas  = document.querySelector('#canvas')
        const context = canvas.getContext('2d')
        const video   = document.querySelector('#video')
        context.drawImage(video, 0, 0, canvas.width, canvas.height)

        stopCamera()

        document.querySelector('#videoPreview'    ).hidden = true
        document.querySelector('#snap'            ).hidden = true
        document.querySelector('#canvasPreview'   ).hidden = false
        document.querySelector('#descriptionGroup').hidden = false
        document.querySelector('#uploadPicture'   ).hidden = false
    }

    function upload(e) {
        if (e.cancelable)
            e.preventDefault()

        const uploadButton = document.querySelector('#uploadPicture')
        const canvas       = document.querySelector('#canvas')
        const picture      = canvas.toDataURL('image/png')
        const description  = document.querySelector('#description').value
        const token        = document.querySelector('input[name="__RequestVerificationToken"]').value

        uploadButton.disabled = true

        $.ajax({
            type: 'POST',
            url: '@Url.Action("UploadCameraImage")',
            headers: { RequestVerificationToken: token },
            data: {
                imageBase64: picture,
                description: description
            }
        }).done(function () {
            location.href = '@Url.Action("Upload")'
        }).fail(function (xhr) {
            alert('Upload failed: ' + (xhr.responseText || xhr.statusText))
        }).always(function () {
            uploadButton.disabled = false
        })
    }
    </script>
}
